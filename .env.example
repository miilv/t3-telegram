# Required
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_USER_ID=
# Additional allowlisted users as id:role entries. The primary ID remains owner.
TELEGRAM_ALLOWED_USERS=
# Group/supergroup ingress is denied unless explicitly enabled.
TELEGRAM_ALLOW_GROUPS=false

# T3 Code environment server
T3_BASE_URL=http://127.0.0.1:3773
T3_BEARER_TOKEN=
T3_PROVIDER_INSTANCE_ID=claude
T3_MODEL=claude-opus-4-1
T3_RUNTIME_MODE=approval-required
# Comma-separated explicit policy categories. High-risk categories are never
# inferred into this list; add them only if you intentionally accept that risk.
APPROVAL_AUTO_ALLOW=safe-read

# Operator runtime. Claude remains the default. Codex is disabled unless both
# the provider and the explicit feature gate are set.
OPERATOR_PROVIDER=claude
CLAUDE_BIN=claude
OPERATOR_MODEL=opus
OPERATOR_EFFORT=high
OPERATOR_CODEX_ENABLED=false
CODEX_BIN=codex
CODEX_MODEL=gpt-5.4
CODEX_EFFORT=high
# Compact after the real provider context reaches this percentage, even before
# the daily maintenance gate.
OPERATOR_COMPACT_THRESHOLD_PERCENT=80

# Live policy defaults. Owner/admin can change these durably through /policy or
# the loopback dashboard without restarting the daemon.
MAX_PARALLEL_WORKERS=4
PROGRESS_INTERVAL_MS=60000
PROVIDER_OPTIMIZATION_ENABLED=true
PROVIDER_COST_WEIGHT=0.35
PROVIDER_LATENCY_WEIGHT=0.35
PROVIDER_RELIABILITY_WEIGHT=0.30
# Optional comma-separated provider/model=estimated-USD-per-turn entries.
PROVIDER_MODEL_COSTS_USD=

# Durable local state
OPERATOR_HOME=~/.operator
LOG_LEVEL=info
# Stable HMAC salt for irreversible Telegram chat pseudonyms in logs/traces.
# Generate a random secret and keep it with the other mode-0600 environment values.
OBSERVABILITY_HASH_SALT=
TELEGRAM_POLL_TIMEOUT_SECONDS=30
# Used only by the explicit legacy T3 snapshot-polling compatibility path.
T3_POLL_INTERVAL_MS=1500

# Media pipeline. ffmpeg/ffprobe are required for voice/video-note conversion.
FFMPEG_BIN=ffmpeg
FFPROBE_BIN=ffprobe
MEDIA_TIMEOUT_MS=45000
MEDIA_MAX_INPUT_BYTES=20971520

# Speech-to-text providers are tried in this order when configured. A local
# Whisper binary is the final fallback; whisper.cpp also requires a model path.
OPENAI_API_KEY=
OPENAI_TRANSCRIPTION_MODEL=gpt-4o-mini-transcribe
GROQ_API_KEY=
GROQ_TRANSCRIPTION_MODEL=whisper-large-v3-turbo
DEEPGRAM_API_KEY=
DEEPGRAM_TRANSCRIPTION_MODEL=nova-3
WHISPER_BIN=
WHISPER_MODEL=

# Text-to-speech prefers ElevenLabs. On macOS /usr/bin/say is used as the local
# fallback; set SAY_BIN explicitly for another compatible local synthesizer.
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM
ELEVENLABS_MODEL=eleven_multilingual_v2
SAY_BIN=

# Optional Google Workspace connectors. Supply a short-lived OAuth bearer with
# Calendar/Gmail scopes; it is stripped from every Operator subprocess.
GOOGLE_WORKSPACE_ACCESS_TOKEN=
GOOGLE_CALENDAR_ID=primary
GMAIL_USER_ID=me
CONNECTOR_TIMEOUT_MS=15000

# Loopback-only admin cockpit. Port 0 chooses a random free port.
DASHBOARD_ENABLED=true
DASHBOARD_PORT=0
