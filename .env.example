# Required
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_USER_ID=
# Additional allowlisted users as id:role entries. The primary ID remains owner.
TELEGRAM_ALLOWED_USERS=
# Group/supergroup ingress is denied unless explicitly enabled.
TELEGRAM_ALLOW_GROUPS=false

# T3 Code environment server
T3_BASE_URL=http://127.0.0.1:3773
T3_BEARER_TOKEN=
T3_PROVIDER_INSTANCE_ID=claude
T3_MODEL=claude-opus-4-1
T3_RUNTIME_MODE=approval-required
# Comma-separated explicit policy categories. High-risk categories are never
# inferred into this list; add them only if you intentionally accept that risk.
APPROVAL_AUTO_ALLOW=safe-read
APPROVAL_TTL_HOURS=6

# Operator runtime. Claude remains the default. Codex is disabled unless both
# the provider and the explicit feature gate are set.
OPERATOR_PROVIDER=claude
CLAUDE_BIN=claude
# Owner personalization for the Operator system prompt: who the agent works
# for and which language it answers in by default.
OWNER_NAME="Ilia Mikhalchuk"
OWNER_LANGUAGE=ru
# Owner's IANA time zone. Drives local-time notions (night secretary window,
# human dates, the 03:00 logical-day boundary). Unset means UTC.
OWNER_TIMEZONE=Europe/Moscow
OPERATOR_MODEL=opus
OPERATOR_EFFORT=high
# Unrestricted host tools (Bash/Read/Write, no permission prompts) for the
# Operator. Opt-in: injected inbound content then reaches a shell on this host.
OPERATOR_FULL_ACCESS=false
OPERATOR_CODEX_ENABLED=false
CODEX_BIN=codex
CODEX_MODEL=gpt-5.4
CODEX_EFFORT=high
# Compact after the real provider context reaches this percentage, even before
# the daily maintenance gate.
OPERATOR_COMPACT_THRESHOLD_PERCENT=80
# Budget for the lightweight out-of-session pass that re-tells worker questions
# and approvals in Russian with task context; on timeout the raw prompt shows.
OPERATOR_MEDIATION_TIMEOUT_MS=15000
# How long a finished work may wait for Operator to retell it in its own words
# before the daemon sends a bare "работа завершилась, подробности позже" notice.
# Worker progress never falls back — it simply waits for the Operator.
OPERATOR_VOICE_FALLBACK_MINUTES=5
# Quiet window before digested worker events wake Operator for one turn.
THREAD_DIGEST_WINDOW_MS=3000
# Watchdog (package 1.5). A turn that emits nothing for WATCHDOG_STALL_SECONDS
# while the owner waits in the queue is interrupted; if it has not settled
# WATCHDOG_GRACE_SECONDS later it is declared a zombie — its queue slot is
# released, its late answer is never delivered, and the owner gets one line.
WATCHDOG_STALL_SECONDS=120
WATCHDOG_GRACE_SECONDS=30
# A running work with a live subscription and no event for this long becomes a
# daemon fact in the digest ("работа молчит N минут"), at most once per window.
# The daemon never interrupts the thread itself — that is Operator's call.
THREAD_STALL_MINUTES=30
# Provider subprocesses inherit an allowlist only (PATH, HOME, PWD, LANG, LC_*,
# TZ, TERM, USER, LOGNAME, SHELL, TMPDIR, XDG_*, NODE_ENV, proxy and CA-bundle
# variables, ANTHROPIC_*, CLAUDE_*, OPENAI_*, the two BASH_*_TIMEOUT_MS
# ceilings). Comma-separated extra names to pass through for your own
# workflows; a trailing `*` matches by prefix (e.g. `WF_*`). Daemon secrets from
# the config schema and T3_OPERATOR_MCP_CAPABILITY are never inherited, and
# passthrough cannot bring them back.
OPERATOR_ENV_PASSTHROUGH=

# Live policy defaults. Owner/admin can change these durably through /policy or
# the loopback dashboard without restarting the daemon.
MAX_PARALLEL_WORKERS=4
PROGRESS_INTERVAL_MS=60000
PROVIDER_OPTIMIZATION_ENABLED=true
PROVIDER_COST_WEIGHT=0.35
PROVIDER_LATENCY_WEIGHT=0.35
PROVIDER_RELIABILITY_WEIGHT=0.30
# Optional comma-separated provider/model=estimated-USD-per-turn entries.
PROVIDER_MODEL_COSTS_USD=

# Durable local state
OPERATOR_HOME=~/.operator
LOG_LEVEL=info
# Stable HMAC salt for irreversible Telegram chat pseudonyms in logs/traces.
# Generate a random secret and keep it with the other mode-0600 environment values.
OBSERVABILITY_HASH_SALT=
TELEGRAM_POLL_TIMEOUT_SECONDS=30
# Used only by the explicit legacy T3 snapshot-polling compatibility path.
T3_POLL_INTERVAL_MS=1500

# Media pipeline. ffmpeg/ffprobe are required for voice/video-note conversion.
FFMPEG_BIN=ffmpeg
FFPROBE_BIN=ffprobe
MEDIA_TIMEOUT_MS=45000
MEDIA_MAX_INPUT_BYTES=20971520

# OpenRouter is the preferred transcription provider when configured, and its
# key also powers the vision-OCR fallback for inbound images.
OPENROUTER_API_KEY=
OPENROUTER_TRANSCRIPTION_MODEL=openai/whisper-large-v3-turbo
# Language forced on every speech-to-text call (ISO-639-1). Whisper otherwise
# guesses from the first seconds, and noise or a clipped opening phrase is
# enough for it to decide the recording is Turkish and "translate" it. Set to
# "auto" to restore provider autodetection.
STT_LANGUAGE=ru
# Local OCR for inbound images/PDF (a Markdown sidecar artifact per file).
OCR_ENABLED=true
TESSERACT_BIN=tesseract
PDFTOTEXT_BIN=pdftotext
PDFTOPPM_BIN=pdftoppm
OCR_LANGS=rus+eng
OCR_MAX_PDF_PAGES=8
OCR_VISION_MODEL=qwen/qwen3.7-flash

# Docling document parsing (docker). The container starts on demand per
# document and is stopped after DOCLING_IDLE_STOP_MINUTES of quiet.
DOCLING_ENABLED=false
DOCLING_ENDPOINT=http://127.0.0.1:5001
DOCLING_CONTAINER=t3-docling
DOCLING_START_TIMEOUT_MS=120000
DOCLING_CONVERT_TIMEOUT_MS=180000
DOCLING_IDLE_STOP_MINUTES=10
DOCLING_OCR_PRESET=rapidocr
DOCLING_OCR_LANG=eslav

# Speech-to-text providers are tried in this order when configured. A local
# Whisper binary is the final fallback; whisper.cpp also requires a model path.
OPENAI_API_KEY=
OPENAI_TRANSCRIPTION_MODEL=gpt-4o-mini-transcribe
GROQ_API_KEY=
GROQ_TRANSCRIPTION_MODEL=whisper-large-v3-turbo
DEEPGRAM_API_KEY=
DEEPGRAM_TRANSCRIPTION_MODEL=nova-3
WHISPER_BIN=
WHISPER_MODEL=

# Text-to-speech prefers ElevenLabs. On macOS /usr/bin/say is used as the local
# fallback; set SAY_BIN explicitly for another compatible local synthesizer.
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM
ELEVENLABS_MODEL=eleven_multilingual_v2
SAY_BIN=

# Optional Google Workspace connectors. Supply a short-lived OAuth bearer with
# Calendar/Gmail scopes; it is stripped from every Operator subprocess.
GOOGLE_WORKSPACE_ACCESS_TOKEN=
GOOGLE_CALENDAR_ID=primary
GMAIL_USER_ID=me
CONNECTOR_TIMEOUT_MS=15000

# Loopback-only admin cockpit. Port 0 chooses a random free port.
DASHBOARD_ENABLED=true
DASHBOARD_PORT=0

# Local Bot API server: lifts the cloud 20 MB inbound file cap.
# TELEGRAM_API_BASE=http://127.0.0.1:8081
# TELEGRAM_LOCAL_FILE_ROOT=/var/lib/telegram-bot-api
# TELEGRAM_LOCAL_HOST_ROOT=/home/you/.operator/telegram-bot-api
# MEDIA_MAX_INPUT_BYTES=524288000
# MEDIA_STT_MAX_UPLOAD_BYTES=20971520
# MEDIA_STT_SEGMENT_SECONDS=900
# MEDIA_LONG_TIMEOUT_MS=1800000
# TELEGRAM_MAX_UPLOAD_BYTES=2097152000
# TELEGRAM_LOCAL_FILE_RETENTION_HOURS=24
# ARTIFACT_RETENTION_DAYS=30
