{
  "disableBundledSkills": true,
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "mcp__higgsfield__.*",
        "hooks": [
          {
            "type": "command",
            "command": "/usr/bin/python3 /root/.operator/hooks/higgsfield-spend-gate.py",
            "timeout": 10
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/root/.operator/hooks/route-long-work.sh",
            "timeout": 5
          }
        ]
      }
    ]
  },
  "env": {
    "ENABLE_TOOL_SEARCH": "false"
  }
}